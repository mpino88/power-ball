{
  "name": "power-ball-telegram-bot",
  "version": "1.0.0",
  "description": "Bot de Telegram con resultados Florida Lottery (Pick 3 / Pick 4)",
  "main": "dist/bot.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/bot.js",
    "dev": "NODE_ENV=development tsx --env-file=.env src/bot.ts",
    "test:data": "tsx src/test-data-timing.ts",
    "test:flows": "tsx --env-file=.env scripts/test-ballbot-flows.ts",
    "test:unit": "vitest run tests/unit",
    "test:integration": "node --env-file=.env node_modules/.bin/vitest run tests/integration --reporter=verbose",
    "test:all": "node --env-file=.env node_modules/.bin/vitest run --reporter=verbose",
    "test:watch": "vitest tests/unit --watch",
    "test:ci": "node --env-file=.env node_modules/.bin/vitest run --reporter=verbose --reporter=junit --outputFile=test-results/junit.xml"
  },
  "keywords": [
    "telegram",
    "bot",
    "grammy",
    "florida",
    "lottery"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "grammy": "^1.28.0",
    "node-cron": "^4.2.1",
    "pdfjs-dist": "^4.4.168",
    "pg": "^8.20.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.20.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "puppeteer": "^24.15.0",
    "vitest": "^2.0.0",
    "@vitest/coverage-v8": "^2.0.0"
  }
}
